---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const title = "音乐";
const description = "放在这个站上的曲子。";
---

<Layout title={`${title} | ${config.site.title}`} description={description}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={title} class="app-prose">
    <div class="not-prose -mt-2 mb-5 flex gap-2">
      <button
        id="src-repo"
        type="button"
        class="rounded-md border px-4 py-1.5 text-sm"
        data-src="repo"
      >
        仓库源
      </button>
      <button
        id="src-netease"
        type="button"
        class="rounded-md border px-4 py-1.5 text-sm"
        data-src="netease"
      >
        网易源
      </button>
    </div>

    <div id="panel-repo">
      <p class="text-muted-foreground mb-6 text-sm">
        音频存在仓库的 Release 里，播放走 Cloudflare 边缘节点，支持拖动进度。
      </p>

      <div class="not-prose">
        <p id="track-state" class="text-muted-foreground text-sm">正在加载…</p>
        <ul id="track-list" class="divide-border border-border mt-2 divide-y border-y" hidden></ul>
      </div>
    </div>

    <div id="panel-netease" hidden>
      <p class="text-muted-foreground mb-3 text-sm">
        直接调用网易云官方接口。每日推荐不登录也能看，登录后才是根据你口味生成的，并且能看到自己的歌单。
      </p>

      <div id="ne-login" class="not-prose border-border mb-4 rounded-md border p-4">
        <div class="mb-3 flex gap-2">
          <button type="button" data-login="password" class="ne-login-mode rounded-md border px-3 py-1 text-xs">
            密码登录
          </button>
          <button type="button" data-login="captcha" class="ne-login-mode rounded-md border px-3 py-1 text-xs">
            验证码登录
          </button>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <input
            id="ne-phone"
            type="tel"
            inputmode="numeric"
            placeholder="手机号"
            class="border-border bg-background w-36 rounded-md border px-3 py-1.5 text-sm"
          />
          <input
            id="ne-pass"
            type="password"
            placeholder="密码"
            class="border-border bg-background w-36 rounded-md border px-3 py-1.5 text-sm"
          />
          <input
            id="ne-code"
            type="text"
            inputmode="numeric"
            placeholder="验证码"
            class="border-border bg-background hidden w-24 rounded-md border px-3 py-1.5 text-sm"
          />
          <button
            id="ne-send-code"
            type="button"
            class="border-border hidden rounded-md border px-3 py-1.5 text-sm"
          >
            获取验证码
          </button>
          <button id="ne-login-btn" type="button" class="bg-accent text-accent-foreground rounded-md px-4 py-1.5 text-sm">
            登录
          </button>
          <span id="ne-login-msg" class="text-muted-foreground text-xs"></span>
        </div>
      </div>

      <div id="ne-user" class="not-prose mb-4 hidden items-center gap-3">
        <img id="ne-avatar" alt="" class="size-8 rounded-full" />
        <span id="ne-name" class="text-sm"></span>
        <button id="ne-logout" type="button" class="text-muted-foreground text-xs underline">退出</button>
      </div>

      <div class="not-prose mb-3 flex flex-wrap items-center gap-2 text-sm">
        <span class="text-muted-foreground">音质</span>
        <select
          id="ne-quality"
          class="border-border bg-background rounded-md border px-2 py-1 text-sm"
        >
          <option value="standard">标准 128k</option>
          <option value="higher">较高 192k</option>
          <option value="exhigh" selected>极高 320k</option>
          <option value="lossless">无损</option>
        </select>
      </div>

      <div class="not-prose mb-3 flex flex-wrap gap-2">
        <button type="button" data-tab="recommend" class="ne-tab rounded-md border px-3 py-1 text-sm">每日推荐</button>
        <button type="button" data-tab="search" class="ne-tab rounded-md border px-3 py-1 text-sm">搜索</button>
        <button type="button" data-tab="playlists" class="ne-tab rounded-md border px-3 py-1 text-sm">我的歌单</button>
      </div>

      <div id="ne-searchbar" class="not-prose mb-3 hidden gap-2">
        <input
          id="ne-kw"
          type="search"
          placeholder="歌名 / 歌手"
          class="border-border bg-background flex-1 rounded-md border px-3 py-1.5 text-sm"
        />
        <button id="ne-search-btn" type="button" class="border-border rounded-md border px-4 py-1.5 text-sm">搜索</button>
      </div>

      <p id="ne-state" class="text-muted-foreground text-sm">选一个标签开始。</p>
      <ul id="ne-list" class="not-prose divide-border border-border mt-2 divide-y border-y" hidden></ul>
      <div id="ne-playlists" class="not-prose mt-3 hidden grid grid-cols-2 gap-3 sm:grid-cols-3"></div>
    </div>

    <div class="h-24"></div>
  </Main>

  <Footer />
</Layout>

<div
  id="player-bar"
  class="border-border bg-background/95 fixed inset-x-0 bottom-0 z-40 hidden border-t backdrop-blur"
>
  <div class="mx-auto flex max-w-3xl items-center gap-3 px-4 py-3">
    <button
      id="prev"
      type="button"
      class="text-muted-foreground hover:text-accent flex size-9 items-center justify-center rounded-md"
      aria-label="上一首"
    >
      <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
        <path d="M6 5h2v14H6zM20 5v14L9 12z"></path>
      </svg>
    </button>

    <button
      id="play"
      type="button"
      class="bg-accent text-accent-foreground flex size-10 items-center justify-center rounded-full"
      aria-label="播放"
    >
      <svg id="icon-play" viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
        <path d="M8 5v14l11-7z"></path>
      </svg>
      <svg
        id="icon-pause"
        viewBox="0 0 24 24"
        class="hidden size-4"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M7 5h4v14H7zM13 5h4v14h-4z"></path>
      </svg>
    </button>

    <button
      id="next"
      type="button"
      class="text-muted-foreground hover:text-accent flex size-9 items-center justify-center rounded-md"
      aria-label="下一首"
    >
      <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
        <path d="M16 5h2v14h-2zM4 5v14l11-7z"></path>
      </svg>
    </button>

    <button
      id="like"
      type="button"
      class="text-muted-foreground hover:text-accent size-9 items-center justify-center rounded-md"
      style="display: none"
      aria-label="喜欢"
      title="喜欢"
    >
      <svg
        viewBox="0 0 24 24"
        class="size-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path
          d="M20.8 4.6a5.5 5.5 0 00-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 00-7.8 7.8l1 1.1L12 21.2l7.8-7.7 1-1.1a5.5 5.5 0 000-7.8z"
        ></path>
      </svg>
    </button>

    <button
      id="mode"
      type="button"
      class="text-muted-foreground hover:text-accent flex size-9 items-center justify-center rounded-md"
      aria-label="顺序播放"
      title="顺序播放"
    >
      <svg
        id="icon-order"
        viewBox="0 0 24 24"
        class="size-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 6h16M4 12h16M4 18h10"></path>
      </svg>
      <svg
        id="icon-shuffle"
        viewBox="0 0 24 24"
        class="hidden size-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"></path>
      </svg>
      <svg
        id="icon-repeat"
        viewBox="0 0 24 24"
        class="hidden size-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M17 2l4 4-4 4"></path>
        <path d="M3 11V9a4 4 0 014-4h14"></path>
        <path d="M7 22l-4-4 4-4"></path>
        <path d="M21 13v2a4 4 0 01-4 4H3"></path>
        <text x="12" y="15" font-size="8" text-anchor="middle" fill="currentColor" stroke="none">1</text>
      </svg>
    </button>

    <div class="min-w-0 flex-1">
      <div id="now-title" class="truncate text-sm font-medium"></div>
      <div class="text-muted-foreground flex items-center gap-2 text-xs">
        <span id="cur-time" class="tabular-nums">0:00</span>
        <input
          id="seek"
          type="range"
          min="0"
          max="1000"
          value="0"
          class="accent-accent h-1 flex-1 cursor-pointer"
          aria-label="播放进度"
        />
        <span id="dur-time" class="tabular-nums">0:00</span>
      </div>
    </div>

    <input
      id="volume"
      type="range"
      min="0"
      max="100"
      value="100"
      class="accent-accent hidden h-1 w-20 cursor-pointer sm:block"
      aria-label="音量"
    />
  </div>
</div>

<script>
  // 与图片页同理：站点用 ClientRouter，内联脚本只在首次加载执行，
  // 必须挂 astro:page-load 才能在返回本页时重新初始化。
  const AUDIO_MIME: Record<string, string> = {
    mp3: "audio/mpeg",
    flac: "audio/flac",
    wav: "audio/wav",
    m4a: "audio/mp4",
    aac: "audio/aac",
    ogg: "audio/ogg",
    oga: "audio/ogg",
    opus: "audio/ogg",
    aiff: "audio/aiff",
    aif: "audio/aiff",
  };

  type Track = { name: string; title: string; size: number; url: string; id?: number };

  let tracks: Track[] = [];
  let current = -1;
  let audio: HTMLAudioElement | null = null;
  let seeking = false;

  function fmt(seconds: number): string {
    if (!isFinite(seconds) || seconds < 0) return "0:00";
    const m = Math.floor(seconds / 60);
    const s = Math.floor(seconds % 60);
    return `${m}:${String(s).padStart(2, "0")}`;
  }

  function sizeText(bytes: number): string {
    return bytes >= 1048576 ? `${(bytes / 1048576).toFixed(1)} MB` : `${Math.round(bytes / 1024)} KB`;
  }

  function extOf(name: string): string {
    return (name.split(".").pop() || "").toLowerCase();
  }

  type Mode = "order" | "shuffle" | "repeat";

  type Ui = {
    list: HTMLElement;
    state: HTMLElement;
    bar: HTMLElement;
    playBtn: HTMLButtonElement;
    prevBtn: HTMLButtonElement;
    nextBtn: HTMLButtonElement;
    titleEl: HTMLElement;
    curEl: HTMLElement;
    durEl: HTMLElement;
    seek: HTMLInputElement;
    vol: HTMLInputElement;
    iconPlay: HTMLElement;
    iconPause: HTMLElement;
    modeBtn: HTMLButtonElement;
    iconOrder: HTMLElement;
    iconShuffle: HTMLElement;
    iconRepeat: HTMLElement;
  };

  const MODE_ORDER: Mode[] = ["order", "shuffle", "repeat"];
  const MODE_LABEL: Record<Mode, string> = {
    order: "顺序播放",
    shuffle: "随机播放",
    repeat: "单曲循环",
  };

  function loadMode(): Mode {
    try {
      const saved = localStorage.getItem("music-mode");
      if (saved && MODE_ORDER.includes(saved as Mode)) return saved as Mode;
    } catch {
      // localStorage 不可用时忽略
    }
    return "order";
  }

  let mode: Mode = loadMode();

  // 当前播放队列来自哪个源，用于列表高亮
  let queueSource: "repo" | "netease" = "repo";

  function applyMode() {
    if (!ui) return;
    ui.iconOrder.classList.toggle("hidden", mode !== "order");
    ui.iconShuffle.classList.toggle("hidden", mode !== "shuffle");
    ui.iconRepeat.classList.toggle("hidden", mode !== "repeat");
    ui.modeBtn.setAttribute("aria-label", MODE_LABEL[mode]);
    ui.modeBtn.title = MODE_LABEL[mode];
    // 非顺序播放时按钮高亮，一眼看出不是默认状态
    ui.modeBtn.classList.toggle("text-accent", mode !== "order");
  }

  function cycleMode() {
    mode = MODE_ORDER[(MODE_ORDER.indexOf(mode) + 1) % MODE_ORDER.length];
    try {
      localStorage.setItem("music-mode", mode);
    } catch {
      // 忽略
    }
    applyMode();
  }

  /** 随机挑一首，尽量不重复当前这首 */
  function randomIndex(): number {
    if (tracks.length <= 1) return 0;
    let next = current;
    while (next === current) next = Math.floor(Math.random() * tracks.length);
    return next;
  }

  /** 点「下一首」时按当前模式决定去哪首 */
  function nextIndex(): number {
    if (!tracks.length) return 0;
    if (mode === "shuffle") return randomIndex();
    return (current + 1) % tracks.length;
  }

  // 站内跳转会替换 DOM，所以 UI 引用必须每次初始化时刷新，
  // 而 audio 对象和它的监听器只创建一次（音乐要跨页面继续播）。
  let ui: Ui | null = null;

  function setPlaying(on: boolean) {
    if (!ui) return;
    ui.iconPlay.classList.toggle("hidden", on);
    ui.iconPause.classList.toggle("hidden", !on);
    ui.playBtn.setAttribute("aria-label", on ? "暂停" : "播放");
    if (queueSource === "repo") {
      ui.list.querySelectorAll("li").forEach((li, i) => {
        li.classList.toggle("text-accent", i === current);
      });
    } else {
      ui.list.querySelectorAll("li").forEach(li => li.classList.remove("text-accent"));
    }
  }

  function ensureAudio(): HTMLAudioElement {
    if (audio) return audio;
    const el = new Audio();
    el.preload = "metadata";

    el.addEventListener("play", () => setPlaying(true));
    el.addEventListener("pause", () => setPlaying(false));
    el.addEventListener("ended", () => {
      if (mode === "repeat") {
        el.currentTime = 0;
        el.play().catch(() => {});
        return;
      }
      if (mode === "shuffle") {
        playAt(randomIndex(), queueSource);
        return;
      }
      // 顺序播放：还有下一首就继续，最后一首放完就停
      // 注意：自然播完不会触发 pause 事件，要手动把图标切回「播放」
      if (current < tracks.length - 1) playAt(current + 1, queueSource);
      else setPlaying(false);
    });
    el.addEventListener("loadedmetadata", () => {
      if (ui) ui.durEl.textContent = fmt(el.duration);
    });
    el.addEventListener("timeupdate", () => {
      if (!ui) return;
      ui.curEl.textContent = fmt(el.currentTime);
      if (!seeking && el.duration) {
        ui.seek.value = String(Math.round((el.currentTime / el.duration) * 1000));
      }
    });
    el.addEventListener("error", () => {
      if (!ui) return;
      ui.state.hidden = false;
      ui.state.textContent = `这首放不了：${tracks[current]?.title ?? ""}（浏览器不支持该格式，或文件已删除）`;
    });

    audio = el;
    return el;
  }

  /** 把音频的真实状态同步到当前 DOM（导航返回后 DOM 是新的） */
  function syncUi() {
    if (!ui || !audio || current < 0 || !tracks[current]) return;
    ui.bar.classList.remove("hidden");
    ui.titleEl.textContent = tracks[current].title;
    ui.durEl.textContent = fmt(audio.duration);
    ui.curEl.textContent = fmt(audio.currentTime);
    if (audio.duration) {
      ui.seek.value = String(Math.round((audio.currentTime / audio.duration) * 1000));
    }
    setPlaying(!audio.paused);
  }

  async function playAt(index: number, from: "repo" | "netease" = "repo") {
    if (!tracks.length) return;
    current = (index + tracks.length) % tracks.length;
    queueSource = from;
    const track = tracks[current];
    const el = ensureAudio();

    let src = track.url;
    if (!src && track.id) {
      // 网易曲目要现取播放地址，地址有时效
      try {
        const res = await fetch(`/api/netease/url?id=${track.id}&level=${neQuality}`, {
          headers: neteaseHeaders(),
        });
        const data = (await res.json()) as { url?: string | null };
        src = data.url ?? "";
      } catch {
        src = "";
      }
      if (!src) {
        neSay(`《${track.title}》拿不到播放地址（可能要会员、已下架或地区限制）`);
        return;
      }
      track.url = src;
    }
    if (!src) return;

    el.src = src;
    if (ui) {
      ui.bar.classList.remove("hidden");
      ui.titleEl.textContent = track.title;
      ui.curEl.textContent = "0:00";
      ui.durEl.textContent = "0:00";
      ui.seek.value = "0";
    }
    el.play().catch(() => setPlaying(false));
    syncLikeButton();
  }

  function initPlayer() {
    const list = document.getElementById("track-list");
    const state = document.getElementById("track-state");
    const bar = document.getElementById("player-bar");
    const playBtn = document.getElementById("play") as HTMLButtonElement | null;
    const prevBtn = document.getElementById("prev") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("next") as HTMLButtonElement | null;
    const titleEl = document.getElementById("now-title");
    const curEl = document.getElementById("cur-time");
    const durEl = document.getElementById("dur-time");
    const seek = document.getElementById("seek") as HTMLInputElement | null;
    const vol = document.getElementById("volume") as HTMLInputElement | null;
    const iconPlay = document.getElementById("icon-play");
    const iconPause = document.getElementById("icon-pause");
    const modeBtn = document.getElementById("mode") as HTMLButtonElement | null;
    const iconOrder = document.getElementById("icon-order");
    const iconShuffle = document.getElementById("icon-shuffle");
    const iconRepeat = document.getElementById("icon-repeat");

    if (
      !list || !state || !bar || !playBtn || !prevBtn || !nextBtn ||
      !titleEl || !curEl || !durEl || !seek || !vol || !iconPlay || !iconPause ||
      !modeBtn || !iconOrder || !iconShuffle || !iconRepeat
    ) {
      return;
    }
    if (list.dataset.bound === "1") return;
    list.dataset.bound = "1";

    ui = {
      list, state, bar, playBtn, prevBtn, nextBtn,
      titleEl, curEl, durEl, seek, vol, iconPlay, iconPause,
      modeBtn, iconOrder, iconShuffle, iconRepeat,
    };

    modeBtn.onclick = cycleMode;
    applyMode();

    playBtn.onclick = () => {
      const el = ensureAudio();
      if (current < 0) playAt(0);
      else if (el.paused) el.play().catch(() => {});
      else el.pause();
    };
    prevBtn.onclick = () => playAt(current < 0 ? 0 : current - 1, queueSource);
    nextBtn.onclick = () => playAt(nextIndex(), queueSource);

    seek.oninput = () => {
      seeking = true;
      const el = ensureAudio();
      if (el.duration) curEl.textContent = fmt((Number(seek.value) / 1000) * el.duration);
    };
    seek.onchange = () => {
      const el = ensureAudio();
      if (el.duration) el.currentTime = (Number(seek.value) / 1000) * el.duration;
      seeking = false;
    };
    vol.oninput = () => {
      ensureAudio().volume = Number(vol.value) / 100;
    };

    ensureAudio();
    loadTracks();
    initNetease();
  }

  async function loadTracks() {
    if (!ui) return;
    const { list, state } = ui;
    try {
      const res = await fetch("/api/music", { headers: { accept: "application/json" } });
      if (!res.ok) throw new Error(`接口返回 ${res.status}`);
      const data = (await res.json()) as { tracks: Track[] };
      tracks = data.tracks;

      list.innerHTML = "";

      if (!tracks.length) {
        state.hidden = false;
        list.hidden = true;
        state.textContent = "还没有曲子。去后台 /admin 上传。";
        return;
      }

      state.hidden = true;
      list.hidden = false;

      const probe = document.createElement("audio");

      tracks.forEach((track, index) => {
        const ext = extOf(track.name);
        const mime = AUDIO_MIME[ext] ?? "";
        const playable = mime ? probe.canPlayType(mime) !== "" : false;

        const li = document.createElement("li");
        li.dataset.index = String(index);

        const num = document.createElement("span");
        num.className = "text-muted-foreground w-6 text-right text-xs tabular-nums";
        num.textContent = String(index + 1).padStart(2, "0");

        const main = document.createElement("div");
        main.className = "min-w-0 flex-1";

        const name = document.createElement("div");
        name.className = "truncate text-sm font-medium";
        name.textContent = track.title;

        const meta = document.createElement("div");
        meta.className = "text-muted-foreground text-xs";
        meta.textContent = `${ext.toUpperCase()} · ${sizeText(track.size)}${
          playable ? "" : " · 当前浏览器不支持"
        }`;

        main.append(name, meta);
        li.append(num, main);

        if (playable) {
          li.className = "hover:bg-muted/40 flex cursor-pointer items-center gap-3 px-1 py-3";
          li.addEventListener("click", () => playAt(index));
        } else {
          li.className = "flex items-center gap-3 px-1 py-3 opacity-50";
        }

        list.appendChild(li);
      });

      // 列表重建后把正在播放的状态补回去
      syncUi();
    } catch (error) {
      state.hidden = false;
      state.textContent = `加载失败：${(error as Error).message}`;
    }
  }


  /* ==================== 网易源 ==================== */

  type NeSong = {
    id: number;
    name: string;
    artists: string;
    album: string;
    duration: number;
    cover: string;
  };

  type NePlaylist = { id: number; name: string; cover: string; count: number; creator: string };

  let neCookie = "";
  let neProfile: { uid: number; nickname: string; avatar: string } | null = null;
  let neTab: "recommend" | "search" | "playlists" = "recommend";
  let neSongs: NeSong[] = [];
  let source: "repo" | "netease" = "repo";
  let neQuality = "exhigh";
  let likedIds = new Set<number>();
  let neLoginMode: "password" | "captcha" = "password";
  let neCountdownTimer: number | null = null;

  function neSay(text: string) {
    const el = document.getElementById("ne-state");
    if (!el) return;
    el.hidden = false;
    el.textContent = text;
  }

  function neClear() {
    const list = document.getElementById("ne-list");
    const grid = document.getElementById("ne-playlists");
    if (list) {
      list.innerHTML = "";
      list.hidden = true;
    }
    if (grid) {
      grid.innerHTML = "";
      grid.classList.add("hidden");
    }
  }

  function neteaseHeaders(): Record<string, string> {
    return neCookie ? { "x-netease-cookie": neCookie } : {};
  }

  function loadNeteaseAuth() {
    try {
      neCookie = localStorage.getItem("netease-cookie") ?? "";
      const raw = localStorage.getItem("netease-profile");
      neProfile = raw ? (JSON.parse(raw) as { uid: number; nickname: string; avatar: string }) : null;
    } catch {
      neCookie = "";
      neProfile = null;
    }
  }

  function saveNeteaseAuth() {
    try {
      localStorage.setItem("netease-cookie", neCookie);
      localStorage.setItem("netease-profile", neProfile ? JSON.stringify(neProfile) : "");
    } catch {
      // 忽略
    }
  }

  function renderNeUser() {
    const login = document.getElementById("ne-login");
    const user = document.getElementById("ne-user");
    const avatar = document.getElementById("ne-avatar") as HTMLImageElement | null;
    const name = document.getElementById("ne-name");
    if (!login || !user) return;

    const loggedIn = Boolean(neProfile && neCookie);
    login.classList.toggle("hidden", loggedIn);
    user.classList.toggle("hidden", !loggedIn);
    user.classList.toggle("flex", loggedIn);
    if (loggedIn && neProfile) {
      if (avatar) avatar.src = neProfile.avatar;
      if (name) name.textContent = neProfile.nickname;
    }
  }

  async function loadLiked() {
    if (!neCookie || !neProfile) {
      likedIds = new Set();
      return;
    }
    try {
      const data = await neGet(`liked?uid=${neProfile.uid}`);
      likedIds = new Set(((data.ids ?? []) as number[]).map(Number));
    } catch {
      likedIds = new Set();
    }
  }

  /** 心形按钮只在「登录 + 正在放网易曲目」时出现 */
  function syncLikeButton() {
    const btn = document.getElementById("like") as HTMLButtonElement | null;
    if (!btn) return;
    const track = tracks[current];
    const show = queueSource === "netease" && Boolean(neCookie) && Boolean(track?.id);
    btn.style.display = show ? "flex" : "none";

    const liked = show && track?.id ? likedIds.has(track.id) : false;
    btn.classList.toggle("text-red-500", liked);
    btn.classList.toggle("text-muted-foreground", !liked);
    btn.setAttribute("aria-label", liked ? "取消喜欢" : "喜欢");
    btn.title = liked ? "取消喜欢" : "喜欢";
    const svg = btn.querySelector("svg");
    if (svg) svg.setAttribute("fill", liked ? "currentColor" : "none");
  }

  async function toggleLike() {
    const track = tracks[current];
    if (!track?.id) return;
    if (!neCookie) {
      neSay("喜欢歌曲需要先登录。");
      return;
    }
    const next = !likedIds.has(track.id);
    try {
      const res = await fetch("/api/netease/like", {
        method: "POST",
        headers: { "content-type": "application/json", ...neteaseHeaders() },
        body: JSON.stringify({ id: track.id, like: next }),
      });
      const data = (await res.json()) as { ok?: boolean; error?: string; code?: number };
      if (!res.ok || !data.ok) {
        neSay(`喜欢失败：${data.error ?? `HTTP ${res.status}`}`);
        return;
      }
      if (next) likedIds.add(track.id);
      else likedIds.delete(track.id);
      syncLikeButton();
      neSay(next ? "已加入「我喜欢的音乐」" : "已取消喜欢");
    } catch (error) {
      neSay(`喜欢失败：${(error as Error).message}`);
    }
  }

  async function neGet(path: string): Promise<Record<string, unknown>> {
    const res = await fetch(`/api/netease/${path}`, { headers: neteaseHeaders() });
    const data = (await res.json()) as Record<string, unknown>;
    if (!res.ok) throw new Error(String(data.error ?? `HTTP ${res.status}`));
    return data;
  }

  function renderNeSongs(songs: NeSong[]) {
    neSongs = songs;
    const list = document.getElementById("ne-list");
    const box = document.getElementById("ne-playlists");
    if (!list) return;
    if (box) box.classList.add("hidden");
    list.innerHTML = "";
    list.hidden = false;

    if (!songs.length) {
      list.hidden = true;
      neSay("没有结果。");
      return;
    }

    songs.forEach((song, index) => {
      const li = document.createElement("li");
      li.className = "hover:bg-muted/40 flex cursor-pointer items-center gap-3 px-1 py-2.5";

      const num = document.createElement("span");
      num.className = "text-muted-foreground w-6 text-right text-xs tabular-nums";
      num.textContent = String(index + 1).padStart(2, "0");

      const main = document.createElement("div");
      main.className = "min-w-0 flex-1";

      const title = document.createElement("div");
      title.className = "truncate text-sm font-medium";
      title.textContent = song.name;

      const meta = document.createElement("div");
      meta.className = "text-muted-foreground truncate text-xs";
      meta.textContent = [song.artists, song.album].filter(Boolean).join(" · ");

      main.append(title, meta);
      li.append(num, main);
      li.addEventListener("click", () => {
        tracks = songs.map(s => ({
          name: `${s.id}`,
          title: s.artists ? `${s.name} - ${s.artists}` : s.name,
          size: 0,
          url: "",
          id: s.id,
        }));
        void playAt(index, "netease");
      });

      list.appendChild(li);
    });
  }

  function renderNePlaylists(items: NePlaylist[]) {
    const grid = document.getElementById("ne-playlists");
    const list = document.getElementById("ne-list");
    if (!grid) return;
    if (list) list.hidden = true;
    grid.innerHTML = "";
    grid.classList.remove("hidden");

    if (!items.length) {
      grid.classList.add("hidden");
      neSay("没有歌单。");
      return;
    }

    for (const item of items) {
      const card = document.createElement("button");
      card.type = "button";
      card.className =
        "border-border hover:border-accent overflow-hidden rounded-md border text-left";
      card.innerHTML = "";

      const img = document.createElement("img");
      img.src = item.cover;
      img.alt = item.name;
      img.loading = "lazy";
      img.className = "aspect-square w-full object-cover";

      const info = document.createElement("div");
      info.className = "p-2";
      const nm = document.createElement("div");
      nm.className = "truncate text-sm";
      nm.textContent = item.name;
      const sub = document.createElement("div");
      sub.className = "text-muted-foreground text-xs";
      sub.textContent = `${item.count} 首 · ${item.creator}`;
      info.append(nm, sub);

      card.append(img, info);
      card.addEventListener("click", () => void openNePlaylist(item.id));
      grid.appendChild(card);
    }
  }

  async function openNePlaylist(id: number) {
    neSay("正在读取歌单…");
    try {
      const data = await neGet(`playlist?id=${id}`);
      const songs = (data.songs ?? []) as NeSong[];
      neSay(`歌单：${String(data.name ?? "")}（${songs.length} 首）`);
      renderNeSongs(songs);
    } catch (error) {
      neSay(`读取歌单失败：${(error as Error).message}`);
    }
  }

  async function loadNeTab(tab: "recommend" | "search" | "playlists") {
    neTab = tab;
    document.querySelectorAll<HTMLElement>(".ne-tab").forEach(btn => {
      const active = btn.dataset.tab === tab;
      btn.classList.toggle("bg-accent", active);
      btn.classList.toggle("text-accent-foreground", active);
    });

    const bar = document.getElementById("ne-searchbar");
    if (bar) {
      bar.classList.toggle("hidden", tab !== "search");
      bar.classList.toggle("flex", tab === "search");
    }

    if (tab === "search") {
      neClear();
      neSay("输入关键词搜索。");
      return;
    }

    if (tab === "playlists") {
      if (!neCookie || !neProfile) {
        neClear();
        neSay("看自己的歌单需要先登录。");
        return;
      }
      neSay("正在读取歌单…");
      try {
        const data = await neGet(`playlists?uid=${neProfile.uid}`);
        const items = (data.playlists ?? []) as NePlaylist[];
        neSay(`共 ${items.length} 个歌单（收藏 + 创建）`);
        renderNePlaylists(items);
      } catch (error) {
        neSay(`读取歌单失败：${(error as Error).message}`);
      }
      return;
    }

    neSay("正在获取每日推荐…");
    try {
      const data = await neGet("recommend");
      const songs = (data.songs ?? []) as NeSong[];
      neSay(
        `${neCookie ? "根据你的口味生成" : "未登录，显示的是通用推荐"} · ${songs.length} 首`
      );
      renderNeSongs(songs);
    } catch (error) {
      neSay(`获取推荐失败：${(error as Error).message}`);
    }
  }

  function setLoginMode(mode: "password" | "captcha") {
    neLoginMode = mode;
    const pass = document.getElementById("ne-pass");
    const code = document.getElementById("ne-code");
    const send = document.getElementById("ne-send-code");
    pass?.classList.toggle("hidden", mode !== "password");
    code?.classList.toggle("hidden", mode !== "captcha");
    send?.classList.toggle("hidden", mode !== "captcha");

    document.querySelectorAll<HTMLElement>(".ne-login-mode").forEach(btn => {
      const active = btn.dataset.login === mode;
      btn.classList.toggle("bg-accent", active);
      btn.classList.toggle("text-accent-foreground", active);
    });
  }

  async function sendNeteaseCode() {
    const phone = (document.getElementById("ne-phone") as HTMLInputElement | null)?.value.trim() ?? "";
    const msg = document.getElementById("ne-login-msg");
    const btn = document.getElementById("ne-send-code") as HTMLButtonElement | null;
    if (!/^\d{6,15}$/.test(phone)) {
      if (msg) msg.textContent = "先填正确的手机号";
      return;
    }
    if (btn) btn.disabled = true;

    try {
      const res = await fetch("/api/netease/sms/send", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ phone }),
      });
      const data = (await res.json()) as { ok?: boolean; message?: string; error?: string };
      if (!data.ok) {
        if (msg) msg.textContent = data.message || data.error || "发送失败";
        if (btn) btn.disabled = false;
        return;
      }
      if (msg) msg.textContent = "验证码已发送";

      // 60 秒倒计时
      let left = 60;
      if (btn) btn.textContent = `${left}s 后重发`;
      if (neCountdownTimer) window.clearInterval(neCountdownTimer);
      neCountdownTimer = window.setInterval(() => {
        left -= 1;
        if (left <= 0) {
          window.clearInterval(neCountdownTimer!);
          neCountdownTimer = null;
          if (btn) {
            btn.textContent = "获取验证码";
            btn.disabled = false;
          }
        } else if (btn) {
          btn.textContent = `${left}s 后重发`;
        }
      }, 1000);
    } catch (error) {
      if (msg) msg.textContent = `发送失败：${(error as Error).message}`;
      if (btn) btn.disabled = false;
    }
  }

  async function doNeteaseLogin() {
    const phone = (document.getElementById("ne-phone") as HTMLInputElement | null)?.value.trim() ?? "";
    const pass = (document.getElementById("ne-pass") as HTMLInputElement | null)?.value ?? "";
    const code = (document.getElementById("ne-code") as HTMLInputElement | null)?.value.trim() ?? "";
    const msg = document.getElementById("ne-login-msg");

    if (!phone) {
      if (msg) msg.textContent = "手机号不能为空";
      return;
    }
    if (neLoginMode === "password" && !pass) {
      if (msg) msg.textContent = "密码不能为空";
      return;
    }
    if (neLoginMode === "captcha" && !code) {
      if (msg) msg.textContent = "验证码不能为空";
      return;
    }
    if (msg) msg.textContent = "登录中…";

    try {
      const res = await fetch("/api/netease/login", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(
          neLoginMode === "captcha" ? { phone, captcha: code } : { phone, password: pass }
        ),
      });
      const data = (await res.json()) as {
        cookie?: string;
        profile?: { uid: number; nickname: string; avatar: string } | null;
        error?: string;
      };
      if (!res.ok || !data.cookie) {
        if (msg) msg.textContent = data.error ?? "登录失败";
        return;
      }
      neCookie = data.cookie;
      neProfile = data.profile ?? null;
      saveNeteaseAuth();
      if (msg) msg.textContent = "";
      renderNeUser();
      await loadLiked();
      syncLikeButton();
      neSay("登录成功。");
      void loadNeTab(neTab === "playlists" ? "playlists" : "recommend");
    } catch (error) {
      if (msg) msg.textContent = `登录失败：${(error as Error).message}`;
    }
  }

  function switchSource(next: "repo" | "netease") {
    source = next;
    try {
      localStorage.setItem("music-source", next);
    } catch {
      // 忽略
    }

    const repo = document.getElementById("panel-repo");
    const ne = document.getElementById("panel-netease");
    if (repo) repo.hidden = next !== "repo";
    if (ne) ne.hidden = next !== "netease";

    document.querySelectorAll<HTMLElement>("[data-src]").forEach(btn => {
      const active = btn.dataset.src === next;
      btn.classList.toggle("bg-accent", active);
      btn.classList.toggle("text-accent-foreground", active);
      btn.classList.toggle("border-accent", active);
    });

    if (next === "netease" && ne && ne.dataset.loaded !== "1") {
      ne.dataset.loaded = "1";
      void loadNeTab("recommend");
    }
  }

  function initNetease() {
    const panel = document.getElementById("panel-netease");
    if (!panel) return;
    if (panel.dataset.bound === "1") {
      // 返回本页时 DOM 是新的，重新刷一次状态
      renderNeUser();
      switchSource(source);
      return;
    }
    panel.dataset.bound = "1";

    loadNeteaseAuth();
    try {
      const saved = localStorage.getItem("music-source");
      source = saved === "netease" ? "netease" : "repo";
    } catch {
      source = "repo";
    }

    document.querySelectorAll<HTMLElement>("[data-src]").forEach(btn => {
      btn.onclick = () => switchSource(btn.dataset.src === "netease" ? "netease" : "repo");
    });
    document.querySelectorAll<HTMLElement>(".ne-tab").forEach(btn => {
      btn.onclick = () => {
        const tab = btn.dataset.tab;
        if (tab === "recommend" || tab === "search" || tab === "playlists") void loadNeTab(tab);
      };
    });

    const loginBtn = document.getElementById("ne-login-btn");
    if (loginBtn) loginBtn.onclick = () => void doNeteaseLogin();

    document.querySelectorAll<HTMLElement>(".ne-login-mode").forEach(btn => {
      btn.onclick = () => setLoginMode(btn.dataset.login === "captcha" ? "captcha" : "password");
    });
    setLoginMode(neLoginMode);

    const sendCode = document.getElementById("ne-send-code");
    if (sendCode) sendCode.onclick = () => void sendNeteaseCode();

    const likeBtn = document.getElementById("like");
    if (likeBtn) likeBtn.onclick = () => void toggleLike();
    if (neCookie && neProfile) {
      void loadLiked().then(syncLikeButton);
    }

    // 音质：读本地保存的选择
    try {
      const savedQuality = localStorage.getItem("netease-quality");
      if (savedQuality && ["standard", "higher", "exhigh", "lossless"].includes(savedQuality)) {
        neQuality = savedQuality;
      }
    } catch {
      // 忽略
    }
    const quality = document.getElementById("ne-quality") as HTMLSelectElement | null;
    if (quality) {
      quality.value = neQuality;
      quality.onchange = () => {
        neQuality = quality.value;
        try {
          localStorage.setItem("netease-quality", neQuality);
        } catch {
          // 忽略
        }
        neSay(`音质已切到 ${quality.options[quality.selectedIndex].text}，下一首生效`);
      };
    }

    const searchBtn = document.getElementById("ne-search-btn");
    if (searchBtn) {
      searchBtn.onclick = () => {
        const kw = (document.getElementById("ne-kw") as HTMLInputElement | null)?.value.trim() ?? "";
        if (!kw) return;
        neSay("搜索中…");
        void neGet(`search?kw=${encodeURIComponent(kw)}`)
          .then(data => {
            const songs = (data.songs ?? []) as NeSong[];
            neSay(`「${kw}」找到 ${songs.length} 首`);
            renderNeSongs(songs);
          })
          .catch(error => neSay(`搜索失败：${(error as Error).message}`));
      };
    }

    const logout = document.getElementById("ne-logout");
    if (logout) {
      logout.onclick = () => {
        neCookie = "";
        neProfile = null;
        saveNeteaseAuth();
        renderNeUser();
        neSay("已退出登录。");
      };
    }

    renderNeUser();
    switchSource(source);
  }

  document.addEventListener("astro:page-load", initPlayer);
  initPlayer();
</script>
