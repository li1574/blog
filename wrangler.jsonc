{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "li1574-blog",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/img/*", "/audio/*"]
  },
  "vars": {
    "GITHUB_REPO": "li1574/blog",
    "GITHUB_BRANCH": "main",
    "POSTS_DIR": "src/content/posts",
    "IMAGE_BRANCH": "images",
    "IMAGE_DIR": "images",
    "MUSIC_TAG": "music"
  },
  "observability": {
    "enabled": true
  }
}
